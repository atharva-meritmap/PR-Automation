# Application
APP_NAME="PR Automation"
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Database & Redis
DATABASE_URL=postgresql+asyncpg://pr_user:pr_password@localhost:5432/pr_automation
REDIS_URL=redis://localhost:6379/0

# Auth (generate a strong random secret in production)
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin bootstrap (used by `python -m app.cli seed-admin`)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin-password
SEED_ADMIN_NAME="Platform Admin"

# LLM Pitch Generation (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Reply Classification (heuristic | laya)
DECISION_BACKEND=laya
LAYA_MODEL_ID=convaiinnovations/laya
HF_HOME=

# Discovery & Bio Dorking Channels
EXA_API_KEY=
TAVILY_API_KEY=
SEARXNG_BASE_URL=

# Email Resolution & Verification
HUNTER_API_KEY=
PROSPEO_API_KEY=
EMAIL_VERIFIER_PROVIDER=none
EMAIL_VERIFIER_API_KEY=

# Mail Dispatch & Guardrails (dry_run | smtp | resend | gmail | m365)
MAIL_PROVIDER=dry_run
REQUIRE_VERIFIED_EMAIL=true
JOURNALIST_COOLDOWN_DAYS=14
MAX_DAILY_SENDS_PER_MAILBOX=30

# SMTP (when MAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Resend (when MAIL_PROVIDER=resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# IMAP Reply Polling (Celery Beat)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# Scraper & Refresh Settings
SCRAPER_USER_AGENT="PRAutomationBot/1.0 (+https://example.com/bot)"
SCRAPE_DOMAIN_DELAY_SEC=2
REFRESH_STALE_DAYS=14

