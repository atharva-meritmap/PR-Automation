# PR Automation Environment Variables (NEVER commit real secrets to git)

# --- Database & Queue ---
DATABASE_URL=postgresql+asyncpg://pr_user:pr_password@localhost:5432/pr_automation
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:
REDIS_URL=redis://localhost:6379/0

# --- Auth & Encryption ---
JWT_SECRET_KEY=change-me-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
TOKEN_ENCRYPTION_KEY=change-me-to-a-fernet-key-in-production

# --- Initial Admin Seed (CLI only) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-strong-password
SEED_ADMIN_NAME=Platform Admin

# --- Mail Provider (MUST default to dry_run in dev/test) ---
MAIL_PROVIDER=dry_run
REQUIRE_VERIFIED_EMAIL=true

# --- Compliance & Rate Limits ---
JOURNALIST_COOLDOWN_DAYS=14
MAX_DAILY_SENDS_PER_MAILBOX=30
SCRAPE_DOMAIN_DELAY_SEC=2
REFRESH_STALE_DAYS=14

# --- LLM Provider (Phase 3+) ---
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=

# --- Decision Classifier (Laya / LLM) ---
DECISION_BACKEND=laya
LAYA_MODEL_ID=convaiinnovations/laya
HF_HOME=a:/PR-Automation/pr-automation-app/.cache/huggingface

# --- Email Verifier (Phase 2+, optional) ---
EMAIL_VERIFIER_PROVIDER=none
EMAIL_VERIFIER_API_KEY=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000"]

